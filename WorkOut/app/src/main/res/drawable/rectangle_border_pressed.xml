<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- A very light-blue fill (optional) -->
    <solid android:color="#E3F2FD" /> <!-- Light shade of blue, for example -->

    <!-- Thicker or differently colored border to indicate “pressed” -->
