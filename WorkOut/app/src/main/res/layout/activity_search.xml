<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SearchActivity">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:scaleType="centerCrop"
        android:src="@color/blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="184dp"
        android:layout_marginTop="92dp"
        android:fontFamily="serif"
        android:text="Search"
        android:textColor="@color/black"
        android:textSize="50sp"
        android:textStyle="bold|italic"
        app:layout_constraintStart_toStartOf="@+id/backgroundImage"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/searchByCategoryButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="50dp"
        android:backgroundTint="@color/blue"
        android:text="Search by category"
        android:textColor="@color/black"
        app:layout_constraintBottom_toTopOf="@+id/searchByLocationButton"
        app:layout_constraintEnd_toEndOf="@+id/searchByLocationButton"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/backgroundImage"
        app:layout_constraintTop_margin="20dp"
        app:layout_constraintTop_toBottomOf="@+id/backgroundImage" />



    <Button
        android:id="@+id/searchByLocationButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="@color/blue"
        android:text="Search by location"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@+id/searchByCategoryButton"
        app:layout_constraintEnd_toEndOf="@+id/searchByDateButton"
        app:layout_constraintTop_margin="20dp"
        app:layout_constraintTop_toBottomOf="@+id/searchByCategoryButton"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/searchByDateButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="@color/blue"
        android:text="Search by date"
        android:textColor="@color/black"
        app:layout_constraintBottom_toTopOf="@+id/searchByAgeButton"
        app:layout_constraintEnd_toEndOf="@+id/searchByAgeButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="20dp"
        app:layout_constraintTop_toBottomOf="@+id/searchByLocationButton" />

    <Button
        android:id="@+id/searchByAgeButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/blue"
        android:text="Search by age"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="20dp"
        app:layout_constraintTop_toBottomOf="@+id/searchByDateButton" />

</androidx.constraintlayout.widget.ConstraintLayout>